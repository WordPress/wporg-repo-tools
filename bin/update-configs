#!/bin/bash

COLOR_RED='\033[0;31m'
COLOR_NONE='\033[0m'

root=${1:-$(pwd)}

# Three of the configs below carry the text domain. Substituting an empty one
# produces configs that look fine and quietly check less: `WordPress.WP.I18n`
# stops verifying text domains altogether rather than reporting a violation,
# and `@wordpress/i18n-text-domain` allows only the empty string. Fail here
# instead, before anything is written.
if [ -z "$TEXTDOMAIN" ]; then
  echo -e "${COLOR_RED}No text domain defined.${COLOR_NONE}" >&2
  echo "Set TEXTDOMAIN, for example: TEXTDOMAIN=wporg composer exec update-configs" >&2
  exit 1
fi

configdir="$root/vendor/wporg/wporg-repo-tools/configs"
configs=(
  ".eslintrc.js"
  "eslint.config.js"
  ".prettierrc.js"
  ".stylelintrc"
  "phpcs.xml.dist"
)

for file in "${configs[@]}"; do
  if [ -f "$configdir/$file" ]; then
    if [ -f "$root/$file" ]; then
      read -p "$root/$file already exists. Overwrite? [y/N] " overwrite
      case $overwrite in
        y | Y | yes ) ;;
        * )
          echo -e "$file skipped.\n"
          continue
        ;;
      esac
    fi

    echo -n "Copying $file to $root/$file... "

    case $file in
      ".eslintrc.js" | "eslint.config.js" | "phpcs.xml.dist" )
        sed -e "s/\${TEXTDOMAIN}/$TEXTDOMAIN/" "$configdir/$file" > "$root/$file"
      ;;
      * )
        cp "$configdir/$file" "$root/$file"
      ;;
    esac

    echo -e "Done.\n"
  else
    echo -e "${COLOR_RED}Can't copy $configdir/$file because it does not exist.${COLOR_NONE}"
  fi
done
