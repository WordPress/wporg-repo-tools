.wporg-a {
	color: #1e1e1e;
}
/* `rule-empty-line-before`: we customise its exceptions. It never applies to
   the first rule in a file, so the violation below is on the second rule. */
.wporg-b {
	transition: color 120ms ease-in-out, background-color 120ms ease-in-out, border-color 120ms ease-in-out, outline 1ms;
}
