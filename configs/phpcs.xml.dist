<?xml version="1.0" ?>
<ruleset name="WordPress.org Meta Coding Standards">
    <!--
        Setup instructions:

        1) Install PHPCS & all required code standards using `composer install`
        2) Run `composer run lint`. You can use the `-a` flag to run it interactively.

        The rules live in the `wporg` standard and arrive with `composer
        update`; this file only holds project-level settings.

        See these links for useful information:
        - https://github.com/PHPCSStandards/PHP_CodeSniffer/wiki/Annotated-ruleset.xml
        - https://github.com/PHPCSStandards/PHP_CodeSniffer/wiki/Customisable-Sniff-Properties
        - https://github.com/WordPress/WordPress-Coding-Standards/wiki/Customizable-sniff-properties
    -->

    <!-- Exclude 3rd-party files -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>

    <!-- Show progress and sniff codes in all reports. -->
    <arg value="ps" />
    <arg name="colors" />

    <!-- Scan all (php) files in the current folder and subfolders -->
    <file>.</file>
    <arg name="extensions" value="php" />

    <rule ref="wporg" />

    <!--
        Must be set: without it `WordPress.WP.I18n` stops checking text domains
        rather than reporting a violation. This works only because the `wporg`
        standard does not also set `text_domain` — if it did, the standard would
        win, as it does for `testVersion`.
    -->
    <config name="text_domain" value="${TEXTDOMAIN}" />

    <!-- Custom project rules go here -->

</ruleset>
