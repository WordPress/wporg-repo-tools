<phpunit
	bootstrap="tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	cacheDirectory="./tests/.phpunit.cache"
	>

	<php>
		<const name="WP_TESTS_MULTISITE" value="1" />
	</php>

	<testsuites>
		<testsuite name="{$PROJECT_NAME}">
			<directory prefix="test-" suffix=".php">
				./tests/
			</directory>
		</testsuite>
	</testsuites>

	<source>
		<include>
			<directory suffix=".php">example</directory>
			<file>example.php</file>
		</include>
	</source>

	<coverage>
		<report>
			<html outputDirectory="./tests/coverage" />
		</report>
	</coverage>
</phpunit>
